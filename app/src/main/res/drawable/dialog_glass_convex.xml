<?xml version="1.0" encoding="utf-8"?>
<!-- Felugró ablak domború (3D) üvegként: felül fénylő, alul enyhén árnyékos lap, vékony belső fényperemmel -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@drawable/dialog_glass" />
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:centerY="0.35"
                android:centerColor="#00FFFFFF"
                android:endColor="#12000000"
                android:startColor="#2EFFFFFF"
                android:type="linear" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    <item
        android:bottom="1.5dp"
        android:left="1.5dp"
        android:right="1.5dp"
        android:top="1.5dp">
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <stroke
                android:width="1dp"
                android:color="#38FFFFFF" />
            <corners android:radius="26.5dp" />
        </shape>
    </item>
</layer-list>
